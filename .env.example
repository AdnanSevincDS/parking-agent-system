# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=local-parking-agent-system

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM=qwen2.5:7b
LLM_EVAL=qwen2.5:7b
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=2048

# MCP server
MCP_SERVER_URL=http://localhost:8001/sse

# Database paths
SQLITE_DB_PATH=data/parking.db
MILVUS_DB_PATH=data/milvus_parking.db

# RAG tuning
EMBEDDING_MODEL=nomic-embed-text:latest
TEMPERATURE=0.0
TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50